# 默认将文本文件统一为 LF
* text=auto

# Android / Kotlin / Gradle
*.kt     text eol=lf
*.kts    text eol=lf
*.java   text eol=lf
*.xml    text eol=lf
*.json   text eol=lf
*.toml   text eol=lf
*.md     text eol=lf
*.properties text eol=lf

# Shell 脚本
*.sh     text eol=lf

# Windows 批处理脚本
*.bat    text eol=crlf
*.cmd    text eol=crlf

# 二进制文件
*.png    binary
*.jpg    binary
*.jpeg   binary
*.webp   binary
*.ico    binary
*.jar    binary
*.keystore binary